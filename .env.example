# ==========================================
# SIYAM MESSENGER BOT
# FACEBOOK COOKIE GUARDIAN
# ==========================================

# Facebook login email / phone
FB_EMAIL=

# Facebook password
FB_PASSWORD=

# Facebook Authenticator/TOTP secret
# 2FA না থাকলে খালি রাখুন
FB_TOTP_SECRET=

# Existing Messenger appstate
APPSTATE_PATH=./account.txt

# Guardian state directory
GUARDIAN_DIR=./.guardian

# Persistent Facebook browser profile
FB_PROFILE_DIR=./.guardian/facebook-profile

# Facebook URL
FB_BASE_URL=https://www.facebook.com

# Browser User-Agent
FB_USER_AGENT=Mozilla/5.0 (Linux; Android 12; M2102J20SG) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/101.0.0.0 Mobile Safari/537.36

# Guardian checks Facebook session every 15 minutes
GUARDIAN_INTERVAL_MIN=15

# After a failed login, wait 30 minutes before retrying
GUARDIAN_LOGIN_COOLDOWN_MIN=30

# Maximum failed automatic login attempts
GUARDIAN_MAX_LOGIN_FAILURES=3

# true = browser hidden
# false = browser visible
FB_HEADLESS=true
